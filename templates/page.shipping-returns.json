        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Shipping across the UAE",
            "heading_size": "h0"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Every order is custom printed, so please allow 1-3 business days for production before it ships. Once your order ships, delivery across the UAE typically takes 1-3 business days depending on your emirate.</p><p>Orders over AED 150 ship free. Below that, a flat shipping fee applies at checkout. You will receive a shipping confirmation email with a tracking link as soon as your order leaves our studio.</p>"
          }
        }
      },
      "block_order": ["caption", "heading", "text"],
